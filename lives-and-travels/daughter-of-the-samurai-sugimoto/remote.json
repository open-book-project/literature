 Bird","n":"10"},{"f":"chapter-11.html","page":"text/chapter-11.xhtml","t":"My First Journey","n":"11"},{"f":"chapter-12.html","page":"text/chapter-12.xhtml","t":"Travel Education","n":"12"},{"f":"chapter-13.html","page":"text/chapter-13.xhtml","t":"Foreigners","n":"13"},{"f":"chapter-14.html","page":"text/chapter-14.xhtml","t":"Lessons","n":"14"},{"f":"chapter-15.html","page":"text/chapter-15.xhtml","t":"How I Became a Christian","n":"15"},{"f":"chapter-16.html","page":"text/chapter-16.xhtml","t":"Sailing Unknown Seas","n":"16"},{"f":"chapter-17.html","page":"text/chapter-17.xhtml","t":"First Impressions","n":"17"},{"f":"chapter-18.html","page":"text/chapter-18.xhtml","t":"Strange Customs","n":"18"},{"f":"chapter-19.html","page":"text/chapter-19.xhtml","t":"Thinking","n":"19"},{"f":"chapter-20.html","page":"text/chapter-20.xhtml","t":"Neighbours","n":"20"},{"f":"chapter-21.html","page":"text/chapter-21.xhtml","t":"New Experiences","n":"21"},{"f":"chapter-22.html","page":"text/chapter-22.xhtml","t":"Flower in a Strange Land","n":"22"},{"f":"chapter-23.html","page":"text/chapter-23.xhtml","t":"Chiyo","n":"23"},{"f":"chapter-24.html","page":"text/chapter-24.xhtml","t":"In Japan Again","n":"24"},{"f":"chapter-25.html","page":"text/chapter-25.xhtml","t":"Our Tokyo Home","n":"25"},{"f":"chapter-26.html","page":"text/chapter-26.xhtml","t":"Tragic Trifles","n":"26"},{"f":"chapter-27.html","page":"text/chapter-27.xhtml","t":"Honourable Grandmother","n":"27"},{"f":"chapter-28.html","page":"text/chapter-28.xhtml","t":"Sister’s Visit","n":"28"},{"f":"chapter-29.html","page":"text/chapter-29.xhtml","t":"A Lady of Old Japan","n":"29"},{"f":"chapter-30.html","page":"text/chapter-30.xhtml","t":"The White Cow","n":"30"},{"f":"chapter-31.html","page":"text/chapter-31.xhtml","t":"Worthless Treasures","n":"31"},{"f":"chapter-32.html","page":"text/chapter-32.xhtml","t":"The Black Ships","n":"32"}]}